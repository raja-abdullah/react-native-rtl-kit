{
  "name": "react-native-rtl-kit",
  "version": "0.1.0-beta.0",
  "description": "Write marginLeft, get RTL-safe styles. Automatic physical-to-logical style property mapping for React Native.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "react-native",
    "rtl",
    "i18n",
    "internationalization",
    "arabic",
    "urdu",
    "hebrew",
    "stylesheet",
    "expo",
    "right-to-left"
  ],
  "author": "Abdullah Altaf <dev@abdullahaltaf.com> (https://abdullahaltaf.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raja-abdullah/react-native-rtl-kit.git"
  },
  "homepage": "https://github.com/raja-abdullah/react-native-rtl-kit#readme",
  "bugs": {
    "url": "https://github.com/raja-abdullah/react-native-rtl-kit/issues"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-native": ">=0.70"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-native": "^0.72.8",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
