{
  "name": "react-native-rtl-kit",
  "version": "0.1.0",
  "description": "Automatically convert physical React Native style properties (marginLeft, paddingRight, textAlign: 'left', ...) into RTL-safe logical properties.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "react-native",
    "rtl",
    "i18n",
    "arabic",
    "hebrew",
    "urdu",
    "stylesheet"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17",
    "react-native": ">=0.70"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-native": "^0.72.8",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
